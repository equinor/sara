{
  "AppName": "sara-backend",
  "AzureAd": {
    "TenantId": "3aa4a235-b6e2-48d5-9195-7fcf05b459b0",
    "Instance": "https://login.microsoftonline.com"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.IdentityModel": "Warning",
      "System": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "https://*.equinor.com/"
  ],
  "Database": {
    "AllowedAuthMethods": [ "ConnectionString" ],
    "postgresConnectionString": "",
    "Server": "",
    "PostgresDatabase": "",
    "User": "",
    "Timeout": 30
  },
  "KeyVault": {
    "UseKeyVault": true
  },
  "ApiBaseRoute": "",
  "FlotillaBaseUrl": "",
  "ArgoWorkflowsBaseUrl": "",
  "ArgoWorkflowsNamespace": "",
  "Frontend": {
    "Enabled": true
  },
  "Mqtt": {
    "Host": "localhost",
    "Port": 1883,
    "Username": "sara",
    "Topics": [
      "isar/+/inspection_result",
      "isar/+/inspection_value"
    ],
    "MaxRetryAttempts": 5,
    "ShouldFailOnMaxRetries": false,
    "AllowInsecureLocalConnections": false
  },
  "Analysis": {
    "Workflows": {
      "anonymizer": {
        "OutputStorageAccount": ""
      },
      "rain-drop": {
        "OutputStorageAccount": ""
      },
      "fencilla": {
        "OutputStorageAccount": ""
      },
      "cloe": {
        "OutputStorageAccount": ""
      },
      "thermal-reading": {
        "OutputStorageAccount": ""
      },
      "copy-raw-to-visualized": {
        "OutputStorageAccount": ""
      }
    },
    "DefaultAnalysisByInspectionType": {
      "Image": ["Anonymize"]
    },
    "DefaultAnalysisByInspectionTypeAndExtension": {
      "Video": { ".mp4": ["Passthrough"] },
      "ThermalVideo": { ".mp4": ["Passthrough"] },
      "AcousticMeasurement": { ".mp4": ["Passthrough"] }
    },
    "AnalysisGroupTimeoutMinutes": 30
  },
  "SARATimeseriesBaseUrl": "http://sara-timeseries:8200",
  "Storage": {
    "ThermalReferenceStorageAccount": ""
  },
  "Email": {
    "Fencilla": {
      "Installations": {}
    }
  }
