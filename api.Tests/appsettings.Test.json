{
  "AppName": "SaraBackendTest",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com",
    "TenantId": "00000000-0000-0000-0000-000000000000",
    "ClientId": "00000000-0000-0000-0000-000000000000",
    "Domain": "test.local"
  },
  "EndpointConfig": {
    "DefaultScheme": "http",
    "DefaultHost": "localhost",
    "DefaultPort": 8100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [],
  "Database": {
    "UseInMemoryDatabase": false,
    "postgresConnectionString": ""
  },
  "KeyVault": {
    "UseKeyVault": false
  },
  "Frontend": {
    "Enabled": false
  },
  "SARATimeseriesBaseUrl": "",
  "OpenTelemetry": {
    "Enabled": false
  },
  "Storage": {
    "AnonStorageAccount": "anonstore",
    "VisStorageAccount": "visstore",
    "TestStorageAccount": "outstorage"
  },
  "Analysis": {
    "AnalysisGroupTimeoutMinutes": 60,
    "AnalysisGroupTimeoutCheckIntervalSeconds": 60,
    "Analyses": {
      "per-record-test": {
        "Steps": [
          {
            "Workflow": "test-workflow-1"
          }
        ]
      },
      "multi-step-test": {
        "Steps": [
          {
            "Workflow": "test-workflow-1"
          },
          {
            "Workflow": "test-workflow-2"
          }
        ]
      },
      "multi-step-gated-test": {
        "Steps": [
          {
            "Workflow": "test-workflow-1"
          },
          {
            "Workflow": "test-gate"
          },
          {
            "Workflow": "test-workflow-2"
          }
        ]
      },
      "group-test": {
        "Steps": [
          {
            "Workflow": "test-workflow-1"
          }
        ]
      }
    },
    "Workflows": {
      "test-workflow-1": {
        "Template": "test-1",
        "Outputs": {
          "result": {
            "StorageAccount": "TestStorageAccount",
            "Extension": ".json"
          }
        }
      },
      "test-workflow-2": {
        "Template": "test-2",
        "Outputs": {
          "result": {
            "StorageAccount": "TestStorageAccount",
            "Extension": ".json"
          }
        }
      },
      "test-gate": {
        "Template": "test-gate",
        "Outputs": {
          "result": {
            "StorageAccount": "TestStorageAccount",
            "Extension": ".json"
          }
        },
        "SkipChainIf": {
          "ResultJsonKeyToCheckForSkipBoolean": "skip",
          "Value": "true"
        }
      }
    },
    "DefaultAnalysisByInspectionTypeAndExtension": {
      "TestVideo": {
        ".mp4": [
          "multi-step-test"
        ]
      }
    }
  }
}
