# Build the migration runner from the same source commit as the API image.
# Keep the SDK, design-time factory and runner together; the API runtime
# image does not execute migrations.
FROM mcr.microsoft.com/dotnet/sdk:10.0@sha256:e70cdb7f80b0348f5cb85f19a8f670fca061f033d57eed12fa003d58b0e06317
ENV NUGET_PACKAGES=/nuget
WORKDIR /source
COPY api/ ./api/
COPY migration-runner/ ./migration-runner/
WORKDIR /source/api
RUN dotnet restore && dotnet build --no-restore -c Release \
    && dotnet publish ../migration-runner/migration-runner.csproj -c Release -o /runner \
    && chmod -R a+rX /nuget /source \
    && chown -R 1001:1001 /source/api

# DesignTimeContextFactory resolves appsettings from the parent of this directory.
# The Job uses the same app registration and database role as the SARA API.
ENV DOTNET_CLI_HOME=/tmp HOME=/tmp
USER 1001
ENTRYPOINT ["sh", "-ec", "test -n \"${AZURE_FEDERATED_TOKEN_FILE:-}\"; test -n \"${AZURE_CLIENT_ID:-}\"; export AzureAd__ClientId=\"$AZURE_CLIENT_ID\"; exec dotnet /runner/migration-runner.dll"]
