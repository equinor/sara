## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Azure Functions
local.settings.json
functions/LocalFunctionProj/output

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio Code
*.vscode

# Python
# Kept in the root file, not only in workflow-notifier/.gitignore: that
# directory does not exist on every branch, so when it is not checked out its
# ignore rules do not apply and leftover build artifacts on disk show up as
# untracked in unrelated work.
*.venv
*venv
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Environment
*.env
*.editorconfig

# JetBrains Editors
.idea

# Frontend
node_modules/
api/wwwroot/
*.tsbuildinfo

AGENTS.md

# Throwaway local fixtures (DB dumps used by ad-hoc migration tests)
api.Tests/tmp/

# macOS
.DS_Store

# Visual Studio
.vs/
*.DotSettings.user
