        <object label="&lt;b&gt;Installation scoping&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Inspection / reference records use their installation code.&lt;br&gt;Analysis-derived records require access to EVERY linked inspection&#39;s installation.&lt;br&gt;Mixed-installation data is not exposed with only partial access.&lt;/font&gt;" source="sara/api/Services/InstallationAccess.cs&#xa;sara/api.Tests/Controllers/AnalysisRunControllerTests.cs&#xa;sara/api.Tests/Controllers/FeedbackControllerTests.cs" evidence="Verified from working-copy implementation; see sara-architecture-evidence.json" id="scope-rule">
          <mxCell parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#198A83;strokeWidth=1.5;fontColor=#104C49;fontFamily=Helvetica;fontSize=18;spacingLeft=10;spacingRight=10;spacingTop=7;spacingBottom=7;" vertex="1">
            <mxGeometry height="135" width="870" x="50" y="1120" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Server-side enforcement&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Collections are filtered before pagination / aggregation.&lt;br&gt;Denied target access produces HTTP 403; missing authentication produces HTTP 401.&lt;br&gt;Role rules are enforced by the API, not just by hidden frontend controls.&lt;/font&gt;" source="sara/api/Services/InstallationAccess.cs&#xa;sara/api/Controllers/InstallationAccessExceptionFilter.cs&#xa;sara/api.Tests/Controllers/AnalysisRunControllerTests.cs&#xa;sara/api/Program.cs" evidence="Verified from working-copy implementation; see sara-architecture-evidence.json" id="enforcement">
          <mxCell parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#8FABCD;strokeWidth=1.5;fontColor=#173653;fontFamily=Helvetica;fontSize=18;spacingLeft=10;spacingRight=10;spacingTop=7;spacingBottom=7;" vertex="1">
            <mxGeometry height="135" width="870" x="970" y="1120" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;Separate from API caller roles: trusted background processing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;MQTT ingestion and Argo reconciliation run without an HTTP context; InstallationAccess grants them full data access.&lt;br&gt;This is not a user role. Azure / Kubernetes / broker permissions are separate infrastructure controls.&lt;/font&gt;" source="sara/api/Services/InstallationAccess.cs&#xa;sara/api/Program.cs&#xa;sara/api/MQTT/MqttEventHandler.cs&#xa;sara/api/Services/HostedServices/ArgoWorkflowWatcherService.cs" evidence="Verified from working-copy implementation; see sara-architecture-evidence.json" id="background">
          <mxCell parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#B6C2CE;strokeWidth=1.5;fontColor=#334E68;fontFamily=Helvetica;fontSize=18;spacingLeft=10;spacingRight=10;spacingTop=7;spacingBottom=7;" vertex="1">
            <mxGeometry height="115" width="1790" x="50" y="1320" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="footer" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#52667A;fontStyle=0;" value="Role code: ABC is a three-character alphanumeric installation code. Current API rules, not an inventory of actual role assignments.&lt;br&gt;Local code snapshot, not live deployment verification. Edit Data exposes source paths. See sara-architecture-evidence.json for hashes and review notes." vertex="1">
